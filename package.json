{
  "name": "codex-plugin-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Codex plugins maintained in one repository.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "workspaces": ["plugins/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "node scripts/validate-plugins.mjs",
    "smoke": "npm run smoke --workspaces --if-present",
    "check": "npm run typecheck && npm run build && npm run validate && npm run smoke",
    "dev:workflows": "npm run dev --workspace=@codex-plugin/workflows"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}

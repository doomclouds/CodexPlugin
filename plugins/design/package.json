{
  "name": "@codex-plugin/design",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local editable design studio driven by the current Codex conversation or a signed-in Codex worker.",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node runtime/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "preview": "node scripts/preview.mjs",
    "smoke:real": "node --experimental-strip-types scripts/code-real-smoke.ts --real-model",
    "smoke": "node --experimental-strip-types --test tests/*.test.ts && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.28.5",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild-wasm": "0.28.2",
    "parse5": "8.0.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
